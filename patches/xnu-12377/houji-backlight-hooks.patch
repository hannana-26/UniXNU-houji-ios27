 /* Routine io_object_conforms_to */
+// r72 (2026-11-26) houji backlight hook: CoreBrightness drives a backlight only when
+// IOObjectConformsTo(service, "AppleARMBacklight") holds (CBDisplayContaineriOS
+// findBacklight); our service keeps its real class, and the device archive registers
+// its conformance answer through this hook at service start
+// (houji_backlight_set_conforms_hook, package/HoujiBacklight.cpp).
+// Self-contained on purpose: the fileset-release-reference link (board bcm2837)
+// does not carry the device archives, so core must not reference device-archive
+// symbols directly - there the pointer stays null and the fallback never runs.
+// The property grant needs no patch at all: native_sandbox_grant below already
+// stands in for the sandbox verdict on set-properties (int-276) for services that
+// publish NativeSandboxGrantProcess, which HoujiBacklight.cpp does in publishFirst.
+static bool (*houji_backlight_conforms_hook)(const OSObject *object, const char *className) = nullptr;
+extern "C" void houji_backlight_set_conforms_hook(bool (*hook)(const OSObject *, const char *)) {
+	houji_backlight_conforms_hook = hook;
+}
+
 kern_return_t
