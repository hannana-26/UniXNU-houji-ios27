 	io_object_t object,
@@ -2572,6 +2588,7 @@
 	}
 
 	*conforms = (NULL != object->metaCast( className ));
+	if (!*conforms && houji_backlight_conforms_hook) *conforms = houji_backlight_conforms_hook(object, className);
 
